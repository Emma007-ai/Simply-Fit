<%- include("partials/header") %>

<section class="hero">
  <div class="hero-text">
    <h2>This is <span class="hero-highlight">SIMPLY FIT</span></h2>
    <p class="hero-sub">
      A simple fitness tracker that helps you log workouts, stay consistent, 
      and see your progress over time — without any distractions.
    </p>
    <a href="/workouts" class="btn">Go to My Workouts</a>
  </div>

  <div class="hero-logo-wrap">
    <img src="/images/logo.png" alt="Simply Fit Logo" class="hero-logo-img">
  </div>
</section>

<section class="feature-section">
  <h3 class="section-title">What does SIMPLY FIT do for you? </h3>
  <div class="feature-grid">
    <div class="feature-card">
      <h4>Track Workouts</h4>
      <p>Log your exercises with sets, reps, duration, and notes in a clean dashboard.</p>
    </div>

    <div class="feature-card">
      <h4>Stay Organized</h4>
      <p>See all your previous workouts in one place, sorted by most recent.</p>
    </div>

    <div class="feature-card">
      <h4>Keep It Simple</h4>
      <p>No clutter, no ads — just a focused way to record what you did in the gym.</p>
    </div>
  </div>
</section>

<%- include("partials/footer") %>
