<%- include("../partials/header") %>

<form action="/workouts" method="POST" class="form">

  <div class="form-grid">

    <div class="form-group">
      <label>Exercise Name</label>
      <input type="text" name="name" required />
    </div>

    <div class="form-group">
      <label>Category</label>
      <input type="text" name="category" placeholder="Chest, Legs, Cardio, etc." />
    </div>

    <div class="form-group">
      <label>Duration (minutes)</label>
      <input type="number" name="duration" />
    </div>

    <div class="form-group">
      <label>Reps</label>
      <input type="number" name="reps" />
    </div>

    <div class="form-group">
      <label>Sets</label>
      <input type="number" name="sets" />
    </div>

    <div class="form-group">
      <label>Date</label>
      <input type="date" name="date" />
    </div>

    <div class="form-group form-notes">
      <label>Notes</label>
      <textarea name="notes" rows="4"></textarea>
    </div>

  </div>

  <div class="button-row">
    <button type="submit" class="btn">Save Workout</button>
    <a href="/workouts" class="btn btn-secondary">Cancel</a>
  </div>

</form>
