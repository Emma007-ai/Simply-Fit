<%- include("../partials/header") %>

<h2>All Workouts</h2>

<a class="btn" href="/workouts/new">+ Add New Workout</a>

<% if (workouts.length === 0) { %>
  <p>No workouts yet. Start by adding one!</p>
<% } else { %>
  <table class="table">
    <thead>
      <tr>
        <th>Exercise</th>
        <th>Category</th>
        <th>Duration</th>
        <th>Date</th>
        <th>Actions</th>
      </tr>
    </thead>

    <tbody>
      <% workouts.forEach(workout => { %>
        <tr>
          <td><%= workout.name %></td>
          <td><%= workout.category || "-" %></td>
          <td><%= workout.duration || "-" %> min</td>
          <td><%= workout.date.toDateString() %></td>
          <td>
            <a class="btn btn-small" href="/workouts/<%= workout._id %>">View</a>
            <a class="btn btn-secondary btn-small" href="/workouts/<%= workout._id %>/edit">Edit</a>

            <form action="/workouts/<%= workout._id %>?_method=DELETE" 
                  method="POST" class="inline-form">
              <button class="btn btn-danger btn-small" type="submit">Delete</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } %>

<%- include("../partials/footer") %>
