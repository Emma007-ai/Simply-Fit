<%- include("../partials/header") %>

<h2>Edit Workout</h2>

<form action="/workouts/<%= workout._id %>?_method=PUT" method="POST" class="form">

  <div class="form-grid">

    <div class="form-group">
      <label>Exercise Name</label>
      <input type="text" name="name" value="<%= workout.name %>" required />
    </div>

    <div class="form-group">
      <label>Category</label>
      <input type="text" name="category" value="<%= workout.category %>" />
    </div>

    <div class="form-group">
      <label>Duration (minutes)</label>
      <input type="number" name="duration" value="<%= workout.duration %>" />
    </div>

    <div class="form-group">
      <label>Reps</label>
      <input type="number" name="reps" value="<%= workout.reps %>" />
    </div>

    <div class="form-group">
      <label>Sets</label>
      <input type="number" name="sets" value="<%= workout.sets %>" />
    </div>

    <div class="form-group">
      <label>Date</label>
      <input type="date" name="date" 
             value="<%= workout.date.toISOString().split('T')[0] %>" />
    </div>

    <div class="form-group form-notes">
      <label>Notes</label>
      <textarea name="notes" rows="4"><%= workout.notes %></textarea>
    </div>

  </div>

  <div class="button-row">
    <button type="submit" class="btn">Save Changes</button>
    <a href="/workouts/<%= workout._id %>" class="btn btn-secondary">Cancel</a>
  </div>

</form>

<%- include("../partials/footer") %>
